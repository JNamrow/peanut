NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
CRON_SECRET=

# Public demo sandbox (optional). With DEMO_MODE=1 the deployment serves one fictional
# household: /demo signs visitors in, /login is unreachable, bank connections and uploads
# are off, and the data is rebuilt every two hours. The demo login is public by design.
DEMO_MODE=
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
NEXT_PUBLIC_CONTACT_EMAIL=

# Seed (node scripts/seed.mjs). Comma-separated email:Name pairs; each becomes an owner of one shared space.
SEED_USERS=you@example.com:You,partner@example.com:Partner
SEED_SPACE_NAME=Household
SEED_PRIMARY_CURRENCY=ILS
